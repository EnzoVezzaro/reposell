{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "skills": {
    "paths": [".agents/skills", ".opencode/skills"]
  },
  "references": {
    "acc": {
      "repository": "EnzoVezzaro/agents-code-context",
      "branch": "main",
      "description": "ACC — Agent Code Context: the repository context/convention layer behind AGENTS.md contracts, .acc/, and the acc CLI (check/context/graph/impact). Use for ACC semantics, workflows, and bootstrap (acc engine --init-context)."
    }
  },
  "permission": {
    "external_directory": "ask",
    "bash": {
      "*": "allow",
      "rm*": "ask",
      "rmdir*": "ask",
      "mv*": "ask",
      "shred*": "ask",
      "git push*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git restore*": "ask",
      "npm publish*": "ask"
    }
  }
}
